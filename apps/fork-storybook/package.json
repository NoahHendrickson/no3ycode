{
  "name": "@t3tools/fork-storybook",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "storybook dev --port 6117 --no-open",
    "build": "storybook build --output-dir storybook-static",
    "typecheck": "effect-tsgo tsrs --noEmit",
    "figma:parse": "pnpm dlx @figma/code-connect@2.1.0 connect parse --skip-update-check",
    "figma:publish": "pnpm dlx @figma/code-connect@2.1.0 connect publish --skip-update-check"
  },
  "devDependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@storybook/addon-docs": "10.6.5",
    "@storybook/react-vite": "10.6.5",
    "@t3tools/contracts": "workspace:*",
    "@t3tools/shared": "workspace:*",
    "@tailwindcss/vite": "catalog:",
    "@tanstack/react-router": "^1.160.2",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitejs/plugin-react": "^6.1.2",
    "react": "catalog:",
    "react-dom": "catalog:",
    "storybook": "10.6.5",
    "vite": "catalog:"
  }
}
